PORT=3000
NODE_ENV=development
# Your own phone number: this account becomes ADMIN (approves sellers/riders). Login with OTP.
ADMIN_PHONE=
# 0 = never show OTP on screen (dev mode shows it only when no SMS provider is set)
DEV_SHOW_OTP=1
# Real SMS OTP via Twilio (leave empty in dev)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
